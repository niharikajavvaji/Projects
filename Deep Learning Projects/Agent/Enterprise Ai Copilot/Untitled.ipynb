   "source": [
    "def planner(state):\n",
    "\n",
    "    question = state[\"question\"].lower()\n",
    "\n",
    "    if \"pdf\" in question:\n",
    "        state[\"tool\"] = \"rag\"\n",
    "\n",
    "    elif \"news\" in question:\n",
    "        state[\"tool\"] = \"search\"\n",
    "\n",
    "    elif \"csv\" in question:\n",
    "        state[\"tool\"] = \"python\"\n",
    "\n",
    "    else:\n",
    "        state[\"tool\"] = \"none\"\n",
    "\n",
    "    return state"
   ]
